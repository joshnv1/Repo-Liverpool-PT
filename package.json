{
  "name": "liverpool-playwright-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Validación de búsquedas en Liverpool mediante la interfaz y la red con Playwright",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node scripts/ejecutar-playwright.js test",
    "test:headed": "node scripts/ejecutar-playwright.js test --headed",
    "test:debug": "node scripts/ejecutar-playwright.js test --debug",
    "report": "node scripts/ejecutar-playwright.js show-report",
    "browsers:install": "node scripts/ejecutar-playwright.js install firefox && node scripts/ejecutar-playwright.js install chrome",
    "pruebas": "npm test",
    "pruebas:unitarias": "npm run test:unit",
    "pruebas:sin-ventana": "node scripts/ejecutar-playwright.js test",
    "pruebas:con-ventana": "node scripts/ejecutar-playwright.js test --headed",
    "pruebas:depurar": "node scripts/ejecutar-playwright.js test --debug",
    "reporte": "node scripts/ejecutar-playwright.js show-report",
    "navegadores:instalar": "node scripts/ejecutar-playwright.js install firefox && node scripts/ejecutar-playwright.js install chrome",
    "navegadores:firefox": "node scripts/ejecutar-playwright.js install firefox",
    "pruebas:firefox": "node scripts/ejecutar-playwright.js test --project=firefox",
    "pruebas:chrome": "node scripts/ejecutar-playwright.js test --project=chrome",
    "pruebas:calidad": "node scripts/ejecutar-playwright.js test calidad.spec.js --project=chrome",
    "referencias:actualizar": "node scripts/ejecutar-playwright.js test calidad.spec.js --project=chrome --update-snapshots=all",
    "pruebas:busquedas": "node scripts/ejecutar-playwright.js test search.spec.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "playwright-extra": "4.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2"
  }
}
